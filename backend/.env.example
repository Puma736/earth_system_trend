# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio.

# Clave de NASA FIRMS. Solo la usa scripts/download_firms.py.
# Se pide en https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Orígenes que pueden llamar a la API (el frontend de Next.js), separados por comas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
