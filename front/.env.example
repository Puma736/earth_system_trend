# Copia este archivo como .env.local y ajusta los valores. El .env.local no se sube al repo.

# Dónde escucha el backend FastAPI, sin barra final. El servidor de Next.js le reenvía
# /api/* y /health, así el navegador (también desde otra computadora de la red) solo usa
# el puerto 3000. Mejor 127.0.0.1 que localhost. Si lo cambias, reinicia npm run dev.
BACKEND_URL=http://127.0.0.1:8000

# Opcional: con esta variable el navegador llama directo a la API, sin pasar por Next.js
# (por ejemplo, con el backend desplegado aparte). El backend debe aceptar el origen
# del front en CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=https://api.example.org
